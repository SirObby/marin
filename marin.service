[Unit]
Description=Marin Discord Bot
After=network.target postgresql.service

[Service]
Type=simple
User=rocky
WorkingDirectory=/home/rocky/marin
ExecStart=/home/rocky/marin/build/marin
Restart=always
RestartSec=5
# Ensure the bot can find its config.json
Environment=DPP_LOG_LEVEL=debug

[Install]
WantedBy=multi-user.target
